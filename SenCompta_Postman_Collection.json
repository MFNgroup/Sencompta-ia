{
  "info": {
    "name": "SenCompta IA — API Tests",
    "_postman_id": "sencompta-mvp-collection",
    "description": "Collection complète pour tester l'API SenCompta IA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:3000", "type": "string" },
    { "key": "PHONE",    "value": "+221771234567",         "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "1. Demander un Magic Link",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/auth/magic-link",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{PHONE}}\",\n  \"boutique_name\": \"Boutique Test Postman\"\n}"
            }
          }
        },
        {
          "name": "2. Vérifier un token Magic Link",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/auth/verify?token=REMPLACER_PAR_LE_TOKEN"
          }
        },
        {
          "name": "3. Récupérer l'utilisateur connecté",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/user/me"
          }
        },
        {
          "name": "4. Déconnexion",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "💬 Webhook WhatsApp",
      "item": [
        {
          "name": "Saisie texte Standard — Recette",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/webhook",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{PHONE}}\",\n  \"message\": \"vendu du riz 15000\"\n}"
            }
          }
        },
        {
          "name": "Saisie texte Standard — Dépense wolof",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/webhook",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{PHONE}}\",\n  \"message\": \"bind légumes 8500 fàkk\"\n}"
            }
          }
        },
        {
          "name": "Saisie texte — Loyer",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/webhook",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{PHONE}}\",\n  \"message\": \"loyer payé 75000 ce mois\"\n}"
            }
          }
        },
        {
          "name": "Saisie texte — Prestation 200k",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/webhook",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{PHONE}}\",\n  \"message\": \"reçu 200k pour prestation couture\"\n}"
            }
          }
        },
        {
          "name": "Message non-comptable",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/webhook",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{PHONE}}\",\n  \"message\": \"Bonjour comment ça va ?\"\n}"
            }
          }
        },
        {
          "name": "Confirmation validation Premium",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/webhook",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{PHONE}}\",\n  \"action\": \"CONFIRM\",\n  \"validation_id\": 1\n}"
            }
          }
        },
        {
          "name": "Annulation validation Premium",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/webhook",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{PHONE}}\",\n  \"action\": \"CANCEL\",\n  \"validation_id\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📊 Transactions",
      "item": [
        {
          "name": "Lister les transactions (30j)",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/transactions?days=30"
          }
        },
        {
          "name": "Créer une transaction (Web)",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/transactions",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"RECETTE\",\n  \"montant\": 50000,\n  \"libelle\": \"Vente de tissu bazin\",\n  \"categorie\": \"Vente marchandise\",\n  \"date\": \"2025-04-15\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🤖 Conseils IA",
      "item": [
        {
          "name": "Obtenir les conseils IA (Premium)",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/ai-advice"
          }
        }
      ]
    },
    {
      "name": "◎ Créances",
      "item": [
        {
          "name": "Lister les créances",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/debts" }
        },
        {
          "name": "Créer une créance",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/debts",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientName\": \"Aminata Diallo\",\n  \"amount\": 35000,\n  \"description\": \"Tissu acheté à crédit\",\n  \"dueDate\": \"2025-05-01\"\n}"
            }
          }
        },
        {
          "name": "Marquer une créance payée",
          "request": {
            "method": "PATCH",
            "url": "{{BASE_URL}}/api/debts/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"PAID\" }" }
          }
        }
      ]
    },
    {
      "name": "💳 Paiement",
      "item": [
        {
          "name": "Initier checkout Standard",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/checkout",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"plan\": \"STANDARD\" }" }
          }
        },
        {
          "name": "Initier checkout Premium",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/checkout",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"plan\": \"PREMIUM\" }" }
          }
        },
        {
          "name": "Simuler IPN PayTech (paiement réussi)",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/callback/payment",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "type_event",       "value": "sale_complete" },
                { "key": "ref_command",      "value": "SC-1-PREMIUM-TEST" },
                { "key": "custom_field",     "value": "{\"user_id\":1,\"plan\":\"PREMIUM\",\"duration\":1}" },
                { "key": "api_key_sha256",   "value": "REMPLACER_PAR_SHA256_DE_VOTRE_API_KEY" },
                { "key": "api_secret_sha256","value": "REMPLACER_PAR_SHA256_DE_VOTRE_API_SECRET" }
              ]
            }
          }
        }
      ]
    }
  ]
}
