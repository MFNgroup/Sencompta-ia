# ══════════════════════════════════════════════════════════════
#  SenCompta IA — Variables d'Environnement
#  Copier dans Vercel → Settings → Environment Variables
# ══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://sencompta-ia.vercel.app
NODE_ENV=production

# ── MySQL Hostinger ───────────────────────────────────────────
# Trouver dans hPanel → Bases de données → cliquer sur la base
DB_HOST=srv123.hostinger.com
DB_PORT=3306
DB_USER=u1234567_sencompta_user
DB_PASSWORD=VotreMotDePasseIci
DB_NAME=u1234567_sencompta

# ── Google Gemini (GRATUIT) ───────────────────────────────────
# Obtenir sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── JWT Session ───────────────────────────────────────────────
# Générer sur : https://generate-secret.vercel.app/64
JWT_SECRET=votre_secret_tres_long_au_moins_64_caracteres

# ── PayTech.sn ────────────────────────────────────────────────
PAYTECH_API_KEY=votre_paytech_api_key
PAYTECH_API_SECRET=votre_paytech_api_secret

# ── WhatsApp Meta Cloud API (production) ──────────────────────
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=sencompta2025
